# Sempre necessárias. Gere este arquivo com `make setup`, nunca à mão.
APP_NAME=Quick Sermon API
# Logs verbosos e SQL no console; deixe false fora da sua máquina.
DEBUG=false
# Gerado por make setup. Sem ela o backend e o worker recusam iniciar.
SECRET_KEY=
# Validade do token de acesso do Editor, em minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Validade do token de renovação, em dias.
REFRESH_TOKEN_EXPIRE_DAYS=7

# Banco da aplicação. A senha aqui deve ser a mesma de POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/quick_sermon
# Senha do Postgres da aplicação dentro do compose.
POSTGRES_PASSWORD=postgres
# Senha do Postgres interno do Temporal dentro do compose.
TEMPORAL_POSTGRES_PASSWORD=temporal

# Temporal, que orquestra o Pipeline dos Clips.
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=video-processing

# Primeiro Admin, criado por `make seed`. A senha é gerada por make setup.
SEED_ADMIN_EMAIL=admin@quicksermon.com
SEED_ADMIN_PASSWORD=

# Onde os Vídeos baixados e os Clips cortados ficam dentro do container.
CLIPS_BASE_DIR=/data/clips
VIDEOS_BASE_DIR=/data/videos

# Limites da Detecção da Pregação, em segundos.
SERMON_MIN_DURATION=900
SERMON_MAX_DURATION=4500
# Abaixo desta duração a Live vira Detecção Pulada.
DETECTION_SKIP_MIN_DURATION=300
# Tempo máximo do workflow de Detecção, em minutos.
DETECTION_WORKFLOW_TIMEOUT_MINUTES=15

# Só para conectar o Canal Conectado e Publicar no YouTube.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Chave Fernet que protege os tokens do Canal Conectado. Gerada por make setup;
# à mão: openssl rand -base64 32 | tr '+/' '-_'
YOUTUBE_OAUTH_ENCRYPTION_KEY=
# Endereço externo onde o backend recebe o retorno do OAuth do YouTube.
YOUTUBE_REDIRECT_BASE_URL=http://localhost

# Só se o YouTube exigir Cookies do YouTube no Download: caminho do arquivo no container.
YTDLP_COOKIES_FILE=/secrets/youtube-cookies.txt

# Só para a IA futura (QS-75); deixe vazia.
OPENAI_API_KEY=

# Origem do frontend: única que o CORS aceita e destino do retorno do OAuth.
# Sem barra no fim: o navegador manda a origem sem ela e o CORS recusaria tudo.
FRONTEND_URL=http://localhost:3000

# Lido pelo frontend, não pelo backend.
NEXT_PUBLIC_API_URL=http://localhost/api
